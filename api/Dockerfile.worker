# jarvis-worker (ADR-016): jobs programados del Cloud Core. Misma base que la API, sin puertos.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/Jarvis.Domain/Jarvis.Domain.csproj src/Jarvis.Domain/
COPY src/Jarvis.Contracts/Jarvis.Contracts.csproj src/Jarvis.Contracts/
COPY src/Jarvis.Application/Jarvis.Application.csproj src/Jarvis.Application/
COPY src/Jarvis.Infrastructure/Jarvis.Infrastructure.csproj src/Jarvis.Infrastructure/
COPY src/Jarvis.Worker/Jarvis.Worker.csproj src/Jarvis.Worker/
RUN dotnet restore src/Jarvis.Worker/Jarvis.Worker.csproj
COPY src/ src/
RUN dotnet publish src/Jarvis.Worker/Jarvis.Worker.csproj -c Release -o /app --no-restore /p:UseAppHost=true

# Runtime chiseled: sin shell ni package manager, usuario no-root (UID/GID 1654).
FROM mcr.microsoft.com/dotnet/runtime:10.0-noble-chiseled AS runtime
WORKDIR /app
COPY --from=build /app .
ENV DOTNET_gcServer=0 \
    DOTNET_TieredPGO=1
USER $APP_UID
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=60s CMD ["/app/jarvis-worker", "healthcheck"]
ENTRYPOINT ["/app/jarvis-worker"]
