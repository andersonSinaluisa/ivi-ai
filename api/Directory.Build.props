<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1848/CA1873: LoggerMessage delegates se usan en rutas calientes, no en todas. CA2007: sin SynchronizationContext en ASP.NET Core. CA1711/CA1716/CA1720: nombres del dominio (Task*, Event*). CA1031: los background services capturan todo para no morir. CA1515: tipos públicos por diseño entre capas. CA1062: nullable habilita el análisis. CA1308/CA1305/CA1307/CA1309/CA1310: textos ASCII del protocolo. CA2227/CA1002/CA1819: DTOs. CA1812: tipos instanciados por DI. CA1822: handlers inyectables. CA5394: Random no criptográfico solo en jitter. CA1724: nombres de namespace. CA1034: tipos anidados de contratos. CA1054/CA1056: URLs como string en configuración. CA2000: ownership gestionado por DI. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1711;CA1716;CA1720;CA1031;CA1515;CA1062;CA1308;CA1305;CA1307;CA1309;CA1310;CA2227;CA1002;CA1819;CA1812;CA1822;CA5394;CA1724;CA1034;CA1054;CA1056;CA2000;CA1032;CA1064;CA1024;CA1303;CA1861;CA1850;CA1863;CA2234;CA1508;CA1859</NoWarn>
  </PropertyGroup>
</Project>
