{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "jarvis-cloud",
    "Audience": "jarvis-api",
    "UserAccessTokenMinutes": 15,
    "DeviceAccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 30
  },
  "Jarvis": {
    "PublicBaseUrl": "https://localhost",
    "MaxDevicesPerOwner": 100,
    "MetricsPort": 8081,
    "CorsOrigins": [],
    "TrustedProxyNetworks": [],
    "Mqtt": {
      "Host": "localhost",
      "Port": 1883,
      "UseTls": false,
      "Username": "jarvis-cloud",
      "PublicHost": "localhost",
      "PublicPort": 8883,
      "AdminTimeoutSeconds": 5,
      "SessionExpirySeconds": 86400,
      "MaxConcurrentMessages": 4
    },
    "Tasks": {
      "AckTimeoutSeconds": 30,
      "MaxAttempts": 5,
      "DispatchIntervalSeconds": 5,
      "DeliveryTimeoutSweepSeconds": 10,
      "ExpirySweepSeconds": 15,
      "CancelResendSeconds": 60,
      "DispatchBatchSize": 50,
      "CreateLimitPerMinute": 30
    },
    "Presence": {
      "HeartbeatIntervalSeconds": 30,
      "StaleAfterSeconds": 75,
      "OfflineAfterSeconds": 180,
      "SweepIntervalSeconds": 15
    },
    "Security": {
      "MqttMessagesPerSecond": 20,
      "MessageTimestampToleranceSeconds": 300,
      "PrincipalStatusCacheSeconds": 30,
      "FloodViolationAfterSeconds": 60,
      "AuthRequestsPerMinute": 20
    },
    "Retention": {
      "Enabled": true,
      "EventsDays": 180,
      "RefreshTokensDays": 30,
      "BatchSize": 5000,
      "IntervalMinutes": 1440
    },
    "BrokerReconciliation": {
      "IntervalMinutes": 60,
      "RetrySeconds": 30
    }
  }
}
