# Ollama del VPS publicado por nginx con TLS y token (opcional; Jarvis no instala Ollama).
# Instalar:  sudo install -d -m 0750 /etc/nginx/jarvis-extra
#            sudo install -m 0640 ollama.conf.example /etc/nginx/jarvis-extra/ollama.conf
#            y sustituir __TOKEN__ por:  openssl rand -hex 32
# Requisito: Ollama escucha SOLO en 127.0.0.1:11434 (nunca publicar 11434).
# En la app: Configuración → Modelos → Ollama remoto, URL https://<dominio>/ollama, clave = el token.
location ^~ /ollama/ {
  if ($http_authorization != "Bearer __TOKEN__") { return 401; }
  limit_req zone=jarvis_api burst=20 nodelay;
  limit_req_status 429;
  client_max_body_size 4m;           # historial + herramientas en cada petición
  proxy_set_header Authorization ""; # el token no llega a Ollama
  proxy_set_header Host 127.0.0.1:11434;
  proxy_buffering off;               # respuestas en streaming
  proxy_read_timeout 600s;           # en CPU una respuesta larga tarda
  proxy_send_timeout 600s;
  proxy_pass http://127.0.0.1:11434/;
}
