# Sitio de Jarvis para el nginx NATIVO del host (ADR-011). deploy.sh reemplaza __JARVIS_DOMAIN__ y lo instala en
# /etc/nginx/sites-available/jarvis.conf (o conf.d/). Se incluye dentro del bloque http {} existente, así que:
# - no usa default_server (el servidor puede alojar otros sitios);
# - todos los nombres (zonas, log_format, map, upstream) llevan prefijo jarvis_ para no chocar con otra configuración.

limit_req_zone  $binary_remote_addr zone=jarvis_auth:10m rate=10r/m;
limit_req_zone  $binary_remote_addr zone=jarvis_api:10m  rate=20r/s;
limit_conn_zone $binary_remote_addr zone=jarvis_hubconn:10m;

# Sin query strings (?access_token= de SignalR) ni Authorization.
log_format jarvis_json escape=json '{"time":"$time_iso8601","ip":"$remote_addr","method":"$request_method","path":"$uri","status":$status,"bytes":$body_bytes_sent,"rt":$request_time,"rid":"$request_id","ua":"$http_user_agent"}';

map $http_upgrade $jarvis_connection_upgrade { default upgrade; '' close; }

upstream jarvis_api { server 127.0.0.1:__JARVIS_API_PORT__; keepalive 16; }

server {
  listen 80;
  listen [::]:80;
  server_name __JARVIS_DOMAIN__;

  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name __JARVIS_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/__JARVIS_DOMAIN__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/__JARVIS_DOMAIN__/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  access_log /var/log/nginx/jarvis.access.log jarvis_json;
  error_log /var/log/nginx/jarvis.error.log warn;
  client_max_body_size 64k;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
  proxy_hide_header X-Powered-By;

  # La API solo confía en X-Forwarded-* desde loopback (nginx en el mismo host).
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Request-Id $request_id;
  proxy_http_version 1.1;
  proxy_set_header Connection "";

  location = /health/live { proxy_read_timeout 5s; proxy_pass http://jarvis_api; }
  location ^~ /health/ { return 404; }
  location ^~ /metrics { return 404; }

  location ^~ /api/v1/auth/ {
    limit_req zone=jarvis_auth burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 4k;
    proxy_read_timeout 15s;
    proxy_pass http://jarvis_api;
  }

  # Sincronización de memoria (docs/03-protocols/sync-protocol.md): lotes de hasta 1 MiB, igual que el límite de la API.
  location = /api/v1/sync/push {
    limit_req zone=jarvis_api burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 1m;
    proxy_read_timeout 30s;
    proxy_pass http://jarvis_api;
  }

  location ^~ /api/ {
    limit_req zone=jarvis_api burst=40 nodelay;
    limit_req_status 429;
    proxy_read_timeout 30s;
    proxy_pass http://jarvis_api;
  }

  location ^~ /hubs/ {
    limit_conn jarvis_hubconn 10;
    limit_conn_status 429;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $jarvis_connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_pass http://jarvis_api;
  }

  # ---- Servicios del owner junto al Cloud Core (ADR-010: el Cloud Core no ejecuta modelos; estos son procesos aparte
  # en 127.0.0.1). Exigen la MISMA credencial que la API: nginx pregunta al Cloud Core (auth_request) y el token no
  # llega al servicio. Un device revocado pierde el acceso. Si un servicio no está levantado, responde 502.
  location = /_jarvis_access {
    internal;
    proxy_pass http://jarvis_api/api/v1/access/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $request_id;
    proxy_read_timeout 5s;
  }

  # Ollama (Qwen y embeddings). Debe escuchar solo en 127.0.0.1:11434.
  location ^~ /ollama/ {
    auth_request /_jarvis_access;
    limit_req zone=jarvis_api burst=20 nodelay;
    limit_req_status 429;
    client_max_body_size 4m;           # historial + herramientas en cada petición
    proxy_set_header Authorization "";
    proxy_set_header Host 127.0.0.1:11434;
    proxy_set_header Connection "";
    proxy_buffering off;               # respuestas en streaming
    proxy_read_timeout 600s;           # en CPU una respuesta larga tarda
    proxy_send_timeout 600s;
    proxy_pass http://127.0.0.1:11434/;
  }

  # jarvis-stt (faster-whisper), deploy/voice. Puerto: JARVIS_STT_PORT en deploy/.env.
  location ^~ /stt/ {
    auth_request /_jarvis_access;
    limit_req zone=jarvis_api burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 10m;          # el servidor limita a 120 s de audio
    proxy_set_header Authorization "";
    proxy_set_header Connection "";
    proxy_read_timeout 120s;
    proxy_pass http://127.0.0.1:__JARVIS_STT_PORT__/;
  }

  # jarvis-tts (Piper), deploy/voice. Puerto: JARVIS_TTS_PORT en deploy/.env.
  location ^~ /tts/ {
    auth_request /_jarvis_access;
    limit_req zone=jarvis_api burst=10 nodelay;
    limit_req_status 429;
    client_max_body_size 64k;          # solo texto
    proxy_set_header Authorization "";
    proxy_set_header Connection "";
    proxy_read_timeout 120s;
    proxy_pass http://127.0.0.1:__JARVIS_TTS_PORT__/;
  }

  # Rutas propias del owner que deploy.sh no gestiona; sobreviven a cada despliegue (vacía = nada).
  include /etc/nginx/jarvis-extra/*.conf;

  location / { return 404; }
}
