# deploy/.env — SIN secretos (viven en $SECRETS_DIR). Lo lee deploy/scripts/deploy.sh y docker compose.
JARVIS_DOMAIN=jarvis.example.com
CERTBOT_EMAIL=owner@example.com
JARVIS_API_IMAGE=jarvis-api:local
JARVIS_WORKER_IMAGE=jarvis-worker:local

# PostgreSQL NATIVO del host (>= 15). La API lo alcanza por 127.0.0.1 (red del host).
PG_PORT=5432
PG_DATABASE=jarvis

# Puertos de jarvis-api, SOLO en 127.0.0.1 (nginx le hace proxy). Cámbialos si otro servicio ya los usa.
JARVIS_API_PORT=8080
JARVIS_METRICS_PORT=8081

SECRETS_DIR=/opt/jarvis/secrets
CONFIG_DIR=/opt/jarvis/config
STATE_DIR=/opt/jarvis/state

# Backups cifrados con age (deploy/scripts/backup.sh). jarvis-worker los monta en SOLO LECTURA para verificarlos;
# backup.sh los deja legibles para este grupo (1654 = usuario no-root de las imágenes .NET chiseled).
BACKUP_DIR=/opt/jarvis/backups
BACKUP_READER_GID=1654
